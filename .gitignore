# Dependencies
node_modules

# Build output
out
dist
release
# ...but the vendored payment-agent compiled output is NOT build output — its
# source lives in a separate repo, so it must be committed for CI to bundle it.
!payment-agent/dist
!payment-agent/dist/**

# Logs
*.log
logs

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
Thumbs.db

# Env
.env
.env.*
!.env.example

# TS build cache
*.tsbuildinfo
.tmp

# Secrets (service-account keys, etc.)
secrets

# AI 로컬 상태 (개인 설정 / 세션 캐시)
.claude/settings.local.json
.omc/

