# .env.example — every environment variable the kiosk build reads.
#
# The REAL `.env` is gitignored (it holds secrets) and is baked into the installer
# at build time via electron-builder `extraResources`. It is NEVER pushed to git.
#   • Local dev:  copy this to `.env` and fill in the blanks.
#   • CI build:   supply the real file via a `KIOSK_ENV` GitHub secret — see
#                 docs/AUTO_UPDATE.md §9 "CI runtime config". Without it, CI builds
#                 a valid AUTO-UPDATING installer but with no API keys (kiosk
#                 features inert). The auto-update feed itself needs none of these.
#
# SECRET / deployment-specific values are left BLANK below; non-secret operational
# defaults are pre-filled. Kiosk identity (W001-W005) is per-machine in
# electron-store (provision-kiosk.ps1), NOT an env var.

# --- Third-party API keys (SECRET — fill in) ---
OPENWEATHER_API_KEY=
EXIM_API_KEY=

# --- Google Sheets content sync (SECRET — fill in) ---
# GOOGLE_SHEETS_ID is only an on/off flag for the night sync (the actual sheet is
# chosen by the provisioned kiosk layout). GOOGLE_SERVICE_ACCOUNT_JSON = path to
# the service-account key under secrets/ (shared across all sheets).
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/service-account.json

# --- AR hanbok image generation (Digicon) ---
# Blank = use the built-in production defaults (kr-kiosk.digicon.pro).
VITE_AR_PROCESS_IMAGE_API_URL=
VITE_AR_PROCESS_API_URL=

# --- Witteria API (shops + stats/analytics). Use the PROD host. ---
WITTERIA_API_BASE=
# Optional single-endpoint overrides: SHOP_API_URL, STATS_MENU_TOUCH_URL,
# STATS_MENU_TOUCHES_SYNC_URL, STATS_SHOTS_URL, STATS_PHOTO_SHOTS_SYNC_URL.
SHOP_API_URL=

# ── Payment agent (W003/W004/W005 — card-terminal kiosks) ──────────────────
# Required (SECRET): PAYMENT_CENTRAL_BASE_URL, PAYMENT_TL3800_TERMINAL_ID.
PAYMENT_HTTP_HOST=127.0.0.1
PAYMENT_HTTP_PORT=8080
PAYMENT_LOG_LEVEL=info
# CORS must include BOTH webview origins (store + vercel donation app), no trailing slash.
PAYMENT_CORS_ORIGINS=https://witteria.com,https://witglobaldonation.vercel.app,https://witglobaldonation.netlify.app,http://localhost:3000,http://localhost:5173
# Central server (SECRET — fill in)
PAYMENT_CENTRAL_BASE_URL=
PAYMENT_CENTRAL_AUTH_TOKEN=
PAYMENT_CENTRAL_TIMEOUT_MS=10000
# TL-3800 terminal — TERMINAL_ID is per-terminal (SECRET — fill in)
PAYMENT_TL3800_TERMINAL_ID=
PAYMENT_TL3800_BAUD_RATE=9600
PAYMENT_TL3800_DATA_BITS=8
PAYMENT_TL3800_STOP_BITS=1
PAYMENT_TL3800_PARITY=none
# Serial port: blank = auto-scan USB-serial (recommended); or a glob (COM*) or literal (COM3)
PAYMENT_TL3800_PORT=
PAYMENT_TL3800_ACK_WAIT_MS=3000
PAYMENT_TL3800_RESP_WAIT_MS=10000
PAYMENT_TL3800_MAX_ACK_RETRY=3
PAYMENT_TL3800_FOLLOWUP_WINDOW_MS=180000
PAYMENT_OUTBOX_WORKER_INTERVAL_MS=15000
PAYMENT_OUTBOX_MAX_ATTEMPTS=20

# --- Local media folders (EXTERNAL to the install dir → survive auto-updates) ---
# Display/attract videos are NOT bundled in the installer. Pre-download them per
# kiosk into <KIOSK_VIDEOS_DIR>/<set>/ (insadong|osaek|hwaseong). Default on a
# packaged Windows kiosk is C:\KioskVideos; set this to override.
KIOSK_VIDEOS_DIR=
# Captured/AI photos are saved here (default C:\KioskPhotos on Windows).
PHOTO_SAVE_DIR=

# Operator DEV mode — `true` shows the in-app W001-W005 switcher. False for live.
DEV_MODE=false

# ── Auto-update (electron-updater + GitHub Releases) ───────────────────────
# Channel this kiosk follows. `latest` = production (ignores pre-releases);
# `beta` = testing (installs beta pre-releases only). No rebuild to switch.
UPDATE_CHANNEL=latest
# Production schedule: weekly maintenance window in LOCAL time (missed windows are
# caught up on next startup). UPDATE_DAY = day name or 0-6 (0=Sun); UPDATE_TIME = HH:MM.
UPDATE_DAY=Friday
UPDATE_TIME=17:00
# Beta schedule: minutes between checks (5-240).
UPDATE_BETA_INTERVAL_MIN=15
# Operator-initiated "update now" (admin-site button). The kiosk polls the
# witteria API for a timestamp and forces an immediate update check when it sees
# a newer one — independent of the weekly window above. Minutes between polls
# (1-60, default 5); UPDATE_COMMAND_API_URL overrides the derived endpoint
# ({WITTERIA_API_BASE}/api/kiosks/{kioskNum}/update-command).
UPDATE_COMMAND_POLL_MIN=5
UPDATE_COMMAND_API_URL=
