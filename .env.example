# Kiosk App — environment variables
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# In development the main process loads `.env` from the project root automatically
# (see src/main/core/env.ts). In production, set these as real OS env vars.

# --- Kiosk location (per-machine deployment) ---
# Which physical kiosk this machine is (W001/W002/W003) is NOT an env var.
# It is the single source of truth in electron-store, set per machine with:
#   powershell -ExecutionPolicy Bypass -File provision-kiosk.ps1 W003 -ShopId 3
# That drives the home tile, card terminal, layout, AND the shop-API kioskId.

# --- Weather (OpenWeatherMap) ---
# Used by the kiosk header. Get a free key at https://openweathermap.org/api
# Fetched in the main process and cached; refreshed every 30 minutes.
OPENWEATHER_API_KEY=

# --- Exchange rates (Korea Eximbank) ---
# Used by the 환율 screen. Get a free key at https://www.koreaexim.go.kr (API → 환율).
# Fetched in the main process and cached; refreshed every 6 hours.
EXIM_API_KEY=

# --- Google Sheets / Drive sync (optional) ---
# Without these the app runs fully offline on seeded/bundled content.
# Share the sheet with the service-account email (Viewer) for read access.
# GOOGLE_SERVICE_ACCOUNT_JSON may be inline JSON OR a path to a gitignored file
# (e.g. secrets/service-account.json — the `secrets/` folder is gitignored).
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=secrets/service-account.json
# Localization_Insa tab -> SQLite `translations` (synced on launch + 02:00 nightly).
# GOOGLE_SHEETS_LOCALIZATION_RANGE=Localization_Insa!A:L
# GOOGLE_DRIVE_FOLDER_ID=

# --- AR hanbok image generation (Digicon) ---
# The photo workflow posts the capture to these endpoints (solo = process_image,
# together/with-INSA = process_and_combine). The main process ships with the
# production URLs built in; set these only to override. Consumed in the main process.
# VITE_AR_PROCESS_IMAGE_API_URL=https://kr-kiosk.digicon.pro/api/v2/process_image
# VITE_AR_PROCESS_API_URL=https://kr-kiosk.digicon.pro/api/v2/process_and_combine
# Optional reference passed as `together_with` for the together/with-INSA mode.
# VITE_AR_TOGETHER_WITH=

# --- Witteria API (production) ---
# Shared base for the shop catalogue + stats/analytics endpoints. Use the PROD
# host. Defaults to https://api-v3.witteria.com if unset.
WITTERIA_API_BASE=https://api-v3.witteria.com
# SHOP_API_URL=https://api-v3.witteria.com/api/shops   # full override (optional)

# --- Usage stats (witteria) ---
# Menu-touch sessions + photo shots POST to ${WITTERIA_API_BASE}/api/stats/*.
# Only set these to point a single endpoint somewhere else.
# STATS_MENU_TOUCH_URL=
# STATS_SHOTS_URL=
# STATS_MENU_TOUCHES_SYNC_URL=
# STATS_PHOTO_SHOTS_SYNC_URL=

# ── Payment agent (W003 / 카드단말기 kiosks only) ───────────────
# Embedded NestJS payment agent. PAYMENT_<AGENT_VAR>. NODE_ENV + OUTBOX_DB_PATH
# are forced by the app. Required: PAYMENT_CENTRAL_BASE_URL, PAYMENT_TL3800_TERMINAL_ID.
PAYMENT_HTTP_HOST=127.0.0.1
PAYMENT_HTTP_PORT=8080
PAYMENT_LOG_LEVEL=info
PAYMENT_CORS_ORIGINS=https://witteria.com,http://localhost:3000,http://localhost:5173,https://witglobaldonation.netlify.app
PAYMENT_CENTRAL_BASE_URL=
PAYMENT_CENTRAL_AUTH_TOKEN=
PAYMENT_CENTRAL_TIMEOUT_MS=10000
PAYMENT_TL3800_TERMINAL_ID=
PAYMENT_TL3800_BAUD_RATE=9600
PAYMENT_TL3800_DATA_BITS=8
PAYMENT_TL3800_STOP_BITS=1
PAYMENT_TL3800_PARITY=none
PAYMENT_TL3800_PORT=
PAYMENT_TL3800_ACK_WAIT_MS=3000
PAYMENT_TL3800_RESP_WAIT_MS=10000
PAYMENT_TL3800_MAX_ACK_RETRY=3
PAYMENT_TL3800_FOLLOWUP_WINDOW_MS=180000
PAYMENT_OUTBOX_WORKER_INTERVAL_MS=15000
PAYMENT_OUTBOX_MAX_ATTEMPTS=20
