# kiosk-electron 환경 변수 예시
#
# 이 파일을 .env 로 복사한 뒤 필요한 항목을 채웁니다.
#   cp .env.example .env
#
# 개발 중에는 프로젝트 루트의 .env 를 자동으로 읽습니다.
# 운영 기기에서는 OS 환경 변수로 주입하며, 이미 설정된 값이 항상 우선합니다.
# 실제 값은 인프라 담당자에게 받으세요. .env 는 커밋되지 않습니다.
#
# 아래 항목은 전부 선택값입니다. 비워 두면 해당 기능만 꺼지고 앱은 정상 기동합니다.


# ─── 백엔드 ───────────────────────────────────────────────
# 자막·버튼 배치·상점·통계 API 주소.
# 비워 두면 https://api-v3.witteria.com (운영) 을 씁니다.
# stage 를 보려면 https://api-stage-v3.witteria.com 로 지정하세요.
WITTERIA_API_BASE=


# ─── 날씨 ────────────────────────────────────────────────
# OpenWeather API 키. 없으면 날씨 위젯이 표시되지 않습니다.
OPENWEATHER_API_KEY=


# ─── Google 연동 (선택) ───────────────────────────────────
# 서비스 계정 JSON. 아래 두 기능의 공통 자격증명이며, 없으면 둘 다 비활성화됩니다.
# ⚠️ JSON 원문이 들어가는 민감값입니다. 절대 커밋하지 마세요.
GOOGLE_SERVICE_ACCOUNT_JSON=

# 시트 동기화 — 시트 ID 를 넣어야 활성화됩니다.
GOOGLE_SHEETS_ID=
# 아래 둘은 비워 두면 기본값을 씁니다.
#   GOOGLE_SHEETS_CONTENT_RANGE  기본값 Content!A:E
#   GOOGLE_SHEETS_ANALYTICS_TAB  기본값 Analytics
GOOGLE_SHEETS_CONTENT_RANGE=
GOOGLE_SHEETS_ANALYTICS_TAB=

# 드라이브 업로드 — 폴더 ID 를 넣어야 활성화됩니다.
GOOGLE_DRIVE_FOLDER_ID=


# ─── 빌드 전용 ────────────────────────────────────────────
# 설치 파일을 만들 때 지점을 지정합니다 (npm run build:win 등).
# W001 북인사마당 · W002 인사동쉼터 · W003 남인사마당
# W004 오색시장   · W005 화성휴게소
# 지정하지 않으면 W001 로 동작합니다.
KIOSK_LOC=
