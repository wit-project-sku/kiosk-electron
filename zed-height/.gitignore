# Per-machine floor calibration — written by `main.py --calibrate`, and correct
# only for the camera on THAT kiosk. Never share it between machines.
calibration.json

# Local dev interpreter. The kiosk uses the system Python the ZED SDK's
# get_python_api.py installed pyzed into, not a venv.
.venv/

__pycache__/
.pytest_cache/

# Per machine like calibration.json: furniture learned from the empty room
# (scene.py), and the floor at visitors' feet relative to the calibration.
background.json
feet_floor.json

# The MediaPipe pose model (30 MB) — provisioned per kiosk, not committed. See README.
models/
